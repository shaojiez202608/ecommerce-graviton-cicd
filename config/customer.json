{
  "_comment": "Handover profile: four environments, two pipelines (develop -> dev; release -> test -> [QA approval] -> uat -> [business approval] -> prod), resources RETAINED on stack deletion. Instance classes are intentionally blank and must be filled in (Graviton families, see docs/deployment-guide.md); uat/prod use HTTPS and need certificate_arn + site_hostname. Loading this file fails until those fields are set (use -c synthCheck=true only for template/cdk-nag checks).",
  "project": "proto-ecom",
  "region": "us-east-1",
  "removal_policy": "retain",
  "ssm_prefix": "/proto-ecom",
  "tags": {
    "Project": "ecommerce-graviton-cicd",
    "Purpose": "prototype"
  },
  "build": {
    "image_variant": "magento",
    "magento_ref": "2.4.8-p5",
    "php_image": "public.ecr.aws/docker/library/php:8.3-fpm-bookworm",
    "codebuild_image": "aws/codebuild/amazonlinux-aarch64-standard:3.0",
    "block_on_severities": [
      "CRITICAL",
      "HIGH"
    ],
    "alarm_email": "",
    "scan_timeout_seconds": 1800,
    "scan_unavailable_action": "fail"
  },
  "pipelines": [
    {
      "name": "develop",
      "source_key": "source/develop.zip",
      "environments": [
        "dev"
      ],
      "approvals_before": {}
    },
    {
      "name": "release",
      "source_key": "source/release.zip",
      "environments": [
        "test",
        "uat",
        "prod"
      ],
      "approvals_before": {
        "uat": "QA sign-off",
        "prod": "Business sign-off"
      }
    }
  ],
  "environments": {
    "dev": {
      "vpc_cidr": "10.40.0.0/16",
      "max_azs": 2,
      "nat_gateways": 1,
      "deployment": "rolling",
      "desired_count": 1,
      "task_cpu": 1024,
      "task_memory_mib": 4096,
      "db_instance_class": "",
      "db_engine_version": "8.4.11",
      "db_multi_az": false,
      "db_allocated_storage_gib": 20,
      "cache_node_type": "",
      "cache_engine_version": "8.1",
      "search_instance_type": "",
      "search_engine_version": "OpenSearch_3.1",
      "search_data_nodes": 1,
      "search_volume_gib": 20,
      "allowed_ingress_cidrs": [],
      "snapshot_before_migrate": false,
      "predeploy_snapshots_keep": 3,
      "base_url_scheme": "http",
      "maintenance_on_failure": "disable",
      "alarms": {
        "cpu_percent": 85,
        "memory_percent": 85,
        "db_free_storage_gib": 2,
        "alb_target_5xx_per_minute": 10
      },
      "mcf": {
        "enabled": true,
        "spapi_mode": "mock",
        "marketplaces": {
          "US": {
            "id": "ATVPDKIKX0DER",
            "region": "na"
          }
        },
        "fulfillment_policy": "FillOrKill",
        "max_attempts": 3,
        "tracking_poll_minutes": 5,
        "inventory_sync_minutes": 60,
        "mock_ship_after_seconds": 60,
        "lambda_memory_mib": 256,
        "intake_batch_size": 1,
        "spapi_http_timeout_seconds": 20
      }
    },
